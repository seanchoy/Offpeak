DATABASE_URL=YOUR_DATABASE_URL
JWT_SECRET_KEY=ANY_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173
# Chat, tool calling and the embeddings behind the AI Planner's search.
GEMINI_API_KEY=

# --- Optional ---
# Route Gemini through a proxy: one URL or a comma-separated list, retried in turn.
GEMINI_PROXY_URL=
GEMINI_PROXY_RETRIES=3
# POI photos; the photo endpoint returns 404 if unset.
GOOGLE_PLACES_API_KEY=
# Google sign-in; its routes return 503 if unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Absolute base for photo links handed to clients (defaults to the production API host).
PUBLIC_API_URL=http://localhost:8000
# Adds an X-Query-Count header to each response; for performance work only.
ENABLE_QUERY_COUNTER=false
